# Firebase Configuration for Capacity Connect (MoES / IMD)
# Obtain these from your Firebase Console -> Project Settings -> General -> Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=capacity-connect-moes.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=capacity-connect-moes
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=capacity-connect-moes.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
